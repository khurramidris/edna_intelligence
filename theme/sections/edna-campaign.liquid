{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
  assign desktop_focus = desktop_image.presentation.focal_point | default: '50% 50%'
  assign mobile_focus = mobile_image.presentation.focal_point | default: '50% 50%'
-%}
<section class="edna edna-hero" style="--hero-height: {{ section.settings.height }}svh; --hero-height-mobile: {{ section.settings.height_mobile }}svh; --hero-focus: {{ desktop_focus }}; --hero-focus-mobile: {{ mobile_focus }};">
  {%- if desktop_image != blank -%}
    <picture class="edna-hero-media">
      {%- if mobile_image != blank -%}
        <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 720 }} 720w, {{ mobile_image | image_url: width: 960 }} 960w" sizes="100vw" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}">
      {%- endif -%}
      {{- desktop_image | image_url: width: 1600 | image_tag: widths: '800,1200,1600,2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'edna-hero-image' -}}
    </picture>
  {%- endif -%}
  <div class="edna-hero-copy">
    {%- if section.settings.eyebrow != blank -%}<p class="edna-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1>{{ section.settings.heading | escape | newline_to_br }}</h1>
    {%- if section.settings.description != blank -%}<p class="edna-hero-description">{{ section.settings.description | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="edna-button" href="{{ section.settings.link | default: '#edna-edit' }}">{{ section.settings.button_label | escape }}{% render 'edna-icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "EDNA hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)",
      "info": "Wide image, about 1800 px across. The focal point set here is used."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image (phone)",
      "info": "Portrait image. Falls back to the desktop image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The first collection"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Headline",
      "default": "Every side\nof you."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Introduction",
      "default": "Quiet confidence. Unexpected edges. A world of footwear, through an EDNA lens."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link",
      "info": "Leave empty to scroll to the product grid."
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height (desktop)",
      "min": 50,
      "max": 90,
      "step": 2,
      "unit": "svh",
      "default": 72
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (phone)",
      "min": 40,
      "max": 80,
      "step": 2,
      "unit": "svh",
      "default": 58
    }
  ],
  "presets": [
    {
      "name": "EDNA hero"
    }
  ]
}
{% endschema %}
