{%- liquid
  assign nav = section.settings.menu | default: linklists['main-menu']
  assign cart_is_page = false
  if template.name == 'cart' or settings.cart_type != 'drawer'
    assign cart_is_page = true
  endif
-%}
<script type="module" src="{{ 'cart-icon.js' | asset_url }}" fetchpriority="low"></script>
<header class="edna edna-header">
  <div class="edna-header-left">
    <details class="edna-menu" data-edna-menu>
      <summary class="edna-icon-button" aria-label="{{ 'edna.general.menu' | t }}">{% render 'edna-icon', name: 'menu' %}</summary>
      <nav class="edna-menu-panel" aria-label="{{ 'edna.general.menu' | t }}">
        <ul>
          {%- for link in nav.links -%}
            <li>
              {%- if link.links.size > 0 -%}
                <p class="edna-menu-group">{{ link.title | escape }}</p>
                <ul>
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
          <li><button type="button" class="edna-text-button" data-edna-wishlist hidden>{{ 'edna.wishlist.title' | t }}</button></li>
        </ul>
      </nav>
    </details>
  </div>
  <a class="edna-logo" href="{{ routes.root_url }}" aria-label="EDNA — {{ 'edna.general.home' | t }}">
    {% if section.settings.logo %}{{ section.settings.logo | image_url: width: 440 | image_tag: widths: '220,440', sizes: '150px', loading: 'eager', alt: 'EDNA Footwear' }}{% else %}<picture><source media="(max-width: 749px)" srcset="{{ 'edna-mobile-logo.svg' | asset_url }}"><img src="{{ 'edna-header-logo.svg' | asset_url }}" width="200" height="46" alt="EDNA Footwear"></picture>{% endif %}
  </a>
  <div class="edna-header-right">
    <button type="button" class="edna-icon-button" on:click="#search-modal/showDialog" aria-haspopup="dialog" aria-label="{{ 'edna.general.search' | t }}">{% render 'edna-icon', name: 'search' %}</button>
    {%- capture bag_icon -%}
      <cart-icon class="header-actions__cart-icon edna-cart-icon" data-testid="cart-icon">
        {% render 'edna-icon', name: 'bag' %}
        {% render 'cart-bubble', limit: 100 %}
      </cart-icon>
    {%- endcapture -%}
    {%- if cart_is_page -%}
      <a class="edna-icon-button edna-bag" href="{{ routes.cart_url }}" aria-label="{{ 'edna.general.bag' | t }}" aria-describedby="cart-bubble-text">{{ bag_icon }}</a>
    {%- else -%}
      <button type="button" class="edna-icon-button edna-bag" on:click="#cart-drawer/toggle" aria-haspopup="dialog" aria-expanded="false" aria-controls="cart-drawer" aria-label="{{ 'edna.general.bag' | t }}" aria-describedby="cart-bubble-text" data-testid="cart-drawer-trigger">{{ bag_icon }}</button>
    {%- endif -%}
  </div>
</header>
<dialog class="edna edna-wishlist" data-edna-wishlist-dialog>
  <div class="edna-dialog-heading"><h2>{{ 'edna.wishlist.title' | t }}</h2><button type="button" class="edna-icon-button" data-edna-close aria-label="{{ 'edna.general.close' | t }}">{% render 'edna-icon', name: 'close' %}</button></div>
  <p>{{ 'edna.wishlist.device_note' | t }}</p><ul data-edna-saved-list></ul><p data-edna-saved-empty>{{ 'edna.wishlist.empty' | t }}</p>
</dialog>
<div class="edna-visually-hidden" data-edna-status role="status" aria-live="polite" data-saved="{{ 'edna.wishlist.saved' | t }}" data-removed="{{ 'edna.wishlist.removed' | t }}" data-unavailable="{{ 'edna.wishlist.unavailable' | t }}"></div>
{% schema %}
{
  "name": "EDNA header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo override"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "info": "Leave empty to use the main menu."
    }
  ],
  "presets": [
    {
      "name": "EDNA header"
    }
  ]
}
{% endschema %}
