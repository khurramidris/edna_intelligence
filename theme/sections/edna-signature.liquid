{%- liquid
  assign signature = section.settings.product
  assign feature_image = section.settings.image | default: signature.featured_image
  assign target_url = section.settings.link | default: signature.url
-%}
{%- if feature_image != blank or request.design_mode -%}
<section class="edna edna-signature">
  <div class="edna-signature-media">
    {%- if feature_image != blank -%}
      {{- feature_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1400', sizes: '(max-width: 749px) 100vw, 60vw', alt: feature_image.alt | default: section.settings.heading -}}
    {%- endif -%}
  </div>
  <div class="edna-signature-copy">
    {%- if section.settings.eyebrow != blank -%}<p class="edna-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- if section.settings.description != blank -%}<p>{{ section.settings.description | escape }}</p>{%- endif -%}
    {%- if target_url != blank -%}
      <a class="edna-link" href="{{ target_url }}">{{ section.settings.link_label | default: signature.title | escape }}{% render 'edna-icon', name: 'arrow' %}</a>
    {%- endif -%}
    {%- if section.settings.video -%}{{ section.settings.video | video_tag: controls: true, muted: true, preload: 'none', image_size: '800x' }}{%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "EDNA feature",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured product",
      "info": "Optional. Its photograph and link are used unless overridden below."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Film"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A different point of view"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Headline",
      "default": "A moment,\nmade yours."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Leave empty to link to the featured product."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    }
  ],
  "presets": [
    {
      "name": "EDNA feature"
    }
  ]
}
{% endschema %}
