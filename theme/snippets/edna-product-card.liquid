{% doc %}
  Renders a real product card with a device-local wishlist control.
  @param {product} item - Shopify product
  @param {boolean} [priority] - Load the image eagerly (use for the first row only)
  @param {boolean} [defer] - Hold the image back until the shopper scrolls near it (use below the first screen)
{% enddoc %}
{%- liquid
  assign name_parts = item.title | split: ' — '
  assign short_title = name_parts.first
  assign second_media = item.media[1]
  assign image_loading = 'lazy'
  if priority
    assign image_loading = 'eager'
  endif
  assign card_sizes = '(max-width: 749px) 46vw, (max-width: 1100px) 31vw, 23vw'
  assign main_image = ''
  assign hover_image = ''
  if item.featured_image
    assign main_image = item.featured_image | image_url: width: 800 | image_tag: loading: image_loading, widths: '320,480,640,800', sizes: card_sizes, class: 'edna-product-image', alt: item.featured_image.alt | default: item.title
  endif
  if second_media.media_type == 'image'
    assign hover_image = second_media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320,480,640,800', sizes: card_sizes, class: 'edna-product-image edna-product-image-alt', alt: ''
    assign hover_image = hover_image | replace: ' src="', ' data-hover-src="' | replace: ' srcset="', ' data-hover-srcset="'
  endif
-%}
<article class="edna-product">
  <div class="edna-product-media">
    <a href="{{ item.url }}" aria-label="{{ item.title | escape }}">
      {%- if main_image != blank -%}
        {%- if defer -%}
          {{- main_image | replace: ' src="', ' data-src="' | replace: ' srcset="', ' data-srcset="' -}}
          <noscript>{{ main_image }}</noscript>
        {%- else -%}
          {{- main_image -}}
        {%- endif -%}
      {%- else -%}
        <span class="edna-no-image">{{ 'edna.general.image_pending' | t }}</span>
      {%- endif -%}
      {{- hover_image -}}
    </a>
    <button type="button" class="edna-icon-button edna-save" data-edna-save data-product-url="{{ item.url }}" data-product-title="{{ short_title | escape }}" data-product-id="{{ item.id }}" aria-label="{{ 'edna.wishlist.save' | t: title: short_title | escape }}" aria-pressed="false" hidden>{% render 'edna-icon', name: 'heart' %}</button>
    {%- unless item.available -%}<span class="edna-sold-out">{{ 'edna.general.sold_out' | t }}</span>{%- endunless -%}
  </div>
  <div class="edna-product-caption">
    <h3><a href="{{ item.url }}">{{ short_title | escape }}</a></h3>
    {%- if item.type != blank -%}<p class="edna-product-type">{{ item.type | escape }}</p>{%- endif -%}
    <span class="edna-price">{% if item.price_varies %}{{ 'edna.general.from' | t }} {% endif %}{{ item.price | money_without_trailing_zeros }}</span>
  </div>
</article>
