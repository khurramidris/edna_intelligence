{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign digits = block.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign size_label = variant.title
  if size_label == 'Default Title'
    assign size_label = ''
  endif
  assign notify_tags = 'notify,notify-' | append: product.handle
  if size_label != blank
    assign size_handle = size_label | handleize
    assign notify_tags = notify_tags | append: ',size-' | append: size_handle | append: ',want:' | append: product.handle | append: ':' | append: size_handle
  endif
  assign heading_text = block.settings.heading | replace: '{size}', size_label | strip
  assign wa_text = block.settings.whatsapp_message | replace: '{product}', product.title
  if size_label != blank
    assign wa_text = wa_text | append: ' (' | append: size_label | append: ')'
  endif
-%}
{%- capture variants_json -%}
  [{%- for v in product.variants -%}{"t":{{ v.title | json }},"a":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
{%- endcapture -%}
{%- capture base_tags -%}notify,notify-{{ product.handle }}{%- endcapture -%}
<div class="edna edna-notify" data-edna-notify data-variants="{{ variants_json | strip | escape }}" data-base-tags="{{ base_tags | escape }}" data-handle="{{ product.handle | escape }}" data-heading="{{ block.settings.heading | escape }}" data-product="{{ product.title | escape }}" data-wa-message="{{ block.settings.whatsapp_message | escape }}" data-wa-number="{{ digits }}"{% if variant.available %} hidden{% endif %} {{ block.shopify_attributes }}>
  <h3 data-edna-notify-heading>{{ heading_text | escape }}</h3>
  <p>{{ block.settings.text | escape }}</p>
  {%- form 'customer', id: 'EdnaNotifyForm', class: 'edna-notify-form' -%}
    {%- if form.posted_successfully? -%}
      <p role="status" class="edna-notify-done">{{ block.settings.success | escape }}</p>
    {%- else -%}
      <input type="hidden" name="contact[tags]" value="{{ notify_tags }}" data-edna-notify-tags>
      <label for="EdnaNotifyEmail" class="edna-visually-hidden">{{ 'edna.newsletter.email' | t }}</label>
      <div class="edna-email-field">
        <input id="EdnaNotifyEmail" type="email" name="contact[email]" placeholder="{{ 'edna.newsletter.email' | t }}" required autocomplete="email" {% if form.errors %}aria-invalid="true"{% endif %}>
        <button type="submit" class="edna-icon-button" aria-label="{{ block.settings.button_label | escape }}">{% render 'edna-icon', name: 'arrow' %}</button>
      </div>
      {%- if form.errors -%}<div role="alert" class="edna-fine-print">{{ form.errors | default_errors }}</div>{%- endif -%}
      <p class="edna-fine-print">{{ block.settings.consent | escape }}</p>
    {%- endif -%}
  {%- endform -%}
  {%- if digits != blank -%}
    <p class="edna-notify-wa"><a class="edna-link" href="https://wa.me/{{ digits }}?text={{ wa_text | url_encode }}" target="_blank" rel="noopener" data-edna-event="whatsapp_clicked" data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}" data-edna-notify-wa>{{ block.settings.whatsapp_label | escape }}{% render 'edna-icon', name: 'arrow' %}</a></p>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "EDNA back in stock",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Use {size} for the selected size.",
      "default": "{size} is sold out"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Leave your email and we will tell you if it returns."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "consent",
      "label": "Consent line",
      "default": "By submitting, you agree to receive EDNA emails. You can unsubscribe at any time."
    },
    {
      "type": "text",
      "id": "success",
      "label": "Confirmation",
      "default": "Thank you. We will be in touch."
    },
    {
      "type": "header",
      "content": "WhatsApp (optional)"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "International format. Leave empty to hide the WhatsApp link."
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp link label",
      "default": "Ask on WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Prefilled message",
      "info": "Use {product} for the product name.",
      "default": "Hello EDNA, could you tell me when {product} is available?"
    }
  ],
  "presets": [
    {
      "name": "EDNA back in stock"
    }
  ]
}
{% endschema %}
